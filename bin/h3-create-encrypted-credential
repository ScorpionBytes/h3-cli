#!/bin/bash
#
# 
# usage: h3-create-encrypted-credential '{"key_type":"cleartext","user":"SMOKE\rob","cleartext":"mypassword"}'
# usage: h3-create-encrypted-credential '{"key_type":"cleartext","user":"rob","cleartext":"mypassword","ip":"192.168.65.3"}'
# usage: h3-create-encrypted-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash"}'
# usage: h3-create-encrypted-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash","ip":"192.168.65.3"}'
# usage: h3-create-encrypted-credential '{"key_type":"aws","aws_access_key_id":"AKxxxxLIWA2Y7OSxxxxx","aws_secret_access_key":"DSAfRxxxxxxxxxxxxZaZolXbsBOl0c/2dxxxxxxx","aws_session_token":""}'
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
input=$1

if [ -z "$input" ]; then 
    echoerr "ERROR: InjectedCredentialInput data is required"
    exit 1
fi


# 2. 
# build variables payload
v=`cat <<HERE
{
    "input": $input
}
HERE
`
v1=`escape_splat "$v"`

# 3.
# invoke h3-gql
res=`h3-gql create_encrypted_credential "$v1"`
rc=$?
if [ $rc -ne 0 ]; then
    echo "$res"
    exit $rc
fi

# 4.
# write the encrypted secret locally
uuid=`cat <<<$res | jq -r .data.create_encrypted_credential.encrypted_credential.uuid`
secret=`cat <<<$res | jq -r .data.create_encrypted_credential.encrypted_secret`
secret_file="$H3_CLI_PROFILES_DIR/$uuid.h3ec"
echoerr "INFO: Writing encrypted credential secret to $secret_file "
echo "$secret" > "$secret_file"
 



