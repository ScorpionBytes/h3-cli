#!/bin/bash
#
# usage:
#
# h3 gql {query}
# h3 pentests ls
# h3 pentests rm
# h3 pentests cancel
# h3 pentests pause
# h3 pentests resume
# h3 pentests latest
# h3 pentests run ?
#   - h3 run-pentest
# h3 pentests launch-nodezero
# h3 nodezero launch  
#   - h3 launch-nodezero
# 
# h3 asset-groups ? 
#
# h3 whoami
# h3 switch-account
# h3 auth
#
# h3 users
# h3 accounts
# 
#
# For verbose tracing: export H3_CLI_VERBOSE=1
# To disable verbose tracing: export H3_CLI_VERBOSE=
#


# writes message to stderr
# usage: echoerr "the message"
function echoerr { 
    echo "[`date`] $@" 1>&2;   
}
 

# writes message to stderr 
# usage: echolog "the message"
function echolog { 
    if [ "$verbose" = "x" ]; then
        echo "[`date`] $@" 1>&2;   
    fi
}


function cmd_help {
    cat <<HERE

h3-cli: A command-line utility for the Horizon3 API.

Usage:

h3 whoami
h3 auth [force]
h3 gql {graphql-file}
h3 pentests
h3 pentest {op_id}
h3 latest-pentest 
h3 create-pentest 
h3 launch-nodezero
h3 run-pentest 
h3 pause-pentest 
h3 resume-pentest 
h3 cancel-pentest 

HERE
    return 1
}


function cmd_pentest {
    if [ -z "$*" ]; then 
        h3x latest_pentest
        rc=$?
        return $rc
    fi
    res=`h3-gql pentest $*` 
    rc=$?
    if [ $rc -eq 0 ]; then
        cat <<<$res | jq .data.pentest
    else
        echo $res
    fi 
    return $rc
}


function cmd_pentests {
    res=`h3-gql pentests $*` 
    rc=$?
    if [ $rc -eq 0 ]; then
        cat <<<$res | jq '.data.pentests_page.pentests[] | {op_id, name, state, scheduled_at, completed_at, etl_completed_at, hosts_count, impacts_count, weaknesses_count, credentials_count}'
    else
        echo $res
    fi 
    return $rc
}


function cmd_whoami {
    res=`h3-gql whoami` 
    rc=$?
    if [ $rc -eq 0 ]; then
        cat <<<$res | jq .data.session_user_account
    else
        echo $res
    fi 
    return $rc
}


function cmd_create_pentest {
    res=`h3-gql schedule_op_template $*`
    rc=$?
    if [ $rc -eq 0 ]; then
        cat <<<$res | jq .data.schedule_op_template.op
    else
        echo $res
    fi 
    return $rc
}


# -----------
# big cmd switch 
# -----------
cmd=$1
shift


if [ "$cmd" = "help" ]; then
    cmd_help $*

elif [ "$cmd" = "whoami" ]; then
    cmd_whoami

elif [ "$cmd" = "auth" ]; then
    h3-auth $*

elif [ "$cmd" = "gql" ]; then
    h3-gql $*

elif [ "$cmd" = "pentests" ]; then
    cmd_pentests $*

elif [ "$cmd" = "pentest" ]; then
    cmd_pentest $*

elif [ "$cmd" = "latest-pentest" -o "$cmd" = "latest_pentest" ]; then
    h3-gql latest_pentest $* | jq .data.pentests_page.pentests[]

elif [ "$cmd" = "create-pentest" -o "$cmd" = "create_pentest" ]; then
    cmd_create_pentest $*

elif [ "$cmd" = "run-pentest" -o "$cmd" = "run_pentest" ]; then
    h3-run-pentest $*

elif [ "$cmd" = "cancel-pentest" -o "$cmd" = "cancel_pentest" ]; then
    h3-cancel-pentest $*

elif [ "$cmd" = "launch-nodezero" ]; then
    h3-launch-nodezero $*

elif [ "$cmd" = "pause-pentest" ]; then
    h3-pause-pentest $*

elif [ "$cmd" = "resume-pentest" ]; then
    h3-resume-pentest $*

else 
    echoerr "ERROR: unrecognized command $cmd"
    exit 1
fi

