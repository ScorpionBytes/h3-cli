#!/bin/bash
#
# 
# usage: h3-create-kubernetes-auto-injected-credential '{"key_type":"cleartext","user":"SMOKE\rob","cleartext":"mypassword"}' kubernetes-namespace kubernetes-runner-name
# usage: h3-create-kubernetes-auto-injected-credential '{"key_type":"cleartext","user":"rob","cleartext":"mypassword","ip":"192.168.65.3"}' kubernetes-namespace kubernetes-runner-name
# usage: h3-create-kubernetes-auto-injected-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash"}' kubernetes-namespace kubernetes-runner-name
# usage: h3-create-kubernetes-auto-injected-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash","ip":"192.168.65.3"}' kubernetes-namespace kubernetes-runner-name
# usage: h3-create-kubernetes-auto-injected-credential '{"key_type":"aws","aws_access_key_id":"AKxxxxLIWA2Y7OSxxxxx","aws_secret_access_key":"DSAfRxxxxxxxxxxxxZaZolXbsBOl0c/2dxxxxxxx","aws_session_token":""}' kubernetes-namespace kubernetes-runner-name
#

# 0.
# include common utils
source h3-env

# 1.
# parse args

# check for optional sse arg
# if specified, the cred is encrypted on the server-side; 
# otherwise the cred is encrypted client-side using openssl.
sse=$1
if [ "$sse" = "sse" ]; then
    shift
else    
    sse=
fi

# read json input
input=$1

if [ -z "$input" ]; then 
    prompterr "Please provide JSON input on a single line: "
    read -r input
    input=`trim_quotes "$input"`
fi

if [ -z "$input" ]; then 
    echoerr "ERROR: InjectedCredentialInput data is required"
    exit 1
fi

namespace=$2

if [ -z "$namespace" ]; then 
    prompterr "Please provide Kubernetes Namespace: "
    read -r namespace
    namespace=`trim_quotes "$namespace"`
fi

runner_name=$3
if [ -z "$runner_name" ]; then 
    prompterr "Please provide Kubernetes Runner Name: "
    read -r runner_name
    runner_name=`trim_quotes "$runner_name"`
fi

# 2. 
# build variables payload
if [ -z "$sse" ]; then 
    # client-side encryption: only send non-secret fields to GQL
    gql_input=`cat <<<$input | jq -c '{key_type, user, aws_access_key_id, ip}'`
else
    # server-side encryption: send everything
    gql_input="$input"
fi
v=`cat <<HERE
{
    "input": $gql_input
}
HERE
`
v1=`escape_splat "$v"`

# 3.
# invoke h3-gql
res=`h3-gql create_auto_injected_credential "$v1"`
rc=$?
if [ $rc -ne 0 ]; then
    echo "$res"
    exit $rc
fi

# 4.
# write the encrypted secret locally
uuid=`cat <<<$res | jq -r .data.create_auto_injected_credential.auto_injected_credential.uuid`
secret_file="$H3_CLI_PROFILES_DIR/$uuid.h3ec"

if [ -z "$sse" ]; then
    # handle client-side encryption
    echoerr "INFO: Encrypting auto-injected credential secret using openssl"
    aes_key_hex=`cat <<<$res | jq -r .data.create_auto_injected_credential.aes_key_hex`
    aes_iv_hex=`cat <<<$res | jq -r .data.create_auto_injected_credential.aes_iv_hex`
    secret_input=`cat <<<$input | jq -c '{cleartext, hash, aws_secret_access_key, aws_session_token}'`
    encrypted=$(echo "$secret_input" | openssl enc -aes-256-cbc -base64 -K "$aes_key_hex" -iv "$aes_iv_hex")
    rc=$?
else
    # handle server-side encryption
    echoerr "INFO: Encrypting auto-injected credential secret to $secret_file "
    encrypted_secret=`cat <<<$res | jq -r .data.create_auto_injected_credential.encrypted_secret`
    encrypted=$(echo "$encrypted_secret" > "$secret_file")
    rc=$?
fi

if [ $rc -ne 0 ]; then
    echoerr "ERROR: Failed to write secret to $secret_file"
    exit $rc
fi

while IFS= read -r line
do
    if [ -z "$formatted_data" ]; then
        formatted_data="    $line"
        continue
    fi
    formatted_data=$(cat <<FMT
$formatted_data
    $line
FMT
)
done < <(printf '%s\n' "$encrypted")

echo $formatted_data

# 5.
# Create and apply the Kubernetes Manifest
aic=$(cat <<EOF
apiVersion: nodezero.horizon3.ai/v1
kind: AutoInjectedCredential
metadata:
  name: ${uuid}
  namespace: ${namespace}
spec:
  runnerName: ${runner_name}
  data: |
${formatted_data}
EOF
)
echo "$aic"
echo "$aic" | kubectl apply -n $namespace -f -
